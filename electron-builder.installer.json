{
  "appId": "com.tiktokshop.videogenerator",
  "productName": "TikTok Shop Video Generator",
  "asar": false,
  "files": [
    "electron/**/*",
    "package.json",
    "assets/**/*",
    "dist/TikTokShopVideoGeneratorCLI/**/*",
    "!dist/TikTokShopVideoGeneratorCLI/**/*.pdb",
    {
      "from": "installer-assets",
      "to": "."
    }
  ],
  "directories": {
    "output": "release-installer"
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TikTok Shop Video Generator"
  },
  "extraResources": [
    {
      "from": "node_modules",
      "to": "app/node_modules",
      "filter": [
        "@puppeteer/browsers/**/*",
        "@types/debug/**/*",
        "@types/ms/**/*",
        "@types/puppeteer/**/*",
        "ansi-regex/**/*",
        "ansi-styles/**/*",
        "arr-union/**/*",
        "balanced-match/**/*",
        "brace-expansion/**/*",
        "buffer-crc32/**/*",
        "bufferutil/**/*",
        "chromium-bidi/**/*",
        "cliui/**/*",
        "clone-deep/**/*",
        "concat-map/**/*",
        "debug/**/*",
        "deepmerge/**/*",
        "devtools-protocol/**/*",
        "emoji-regex/**/*",
        "escalade/**/*",
        "fd-slicer/**/*",
        "for-in/**/*",
        "for-own/**/*",
        "fs-extra/**/*",
        "fs.realpath/**/*",
        "get-caller-file/**/*",
        "get-east-asian-width/**/*",
        "glob/**/*",
        "graceful-fs/**/*",
        "inflight/**/*",
        "inherits/**/*",
        "is-buffer/**/*",
        "is-extendable/**/*",
        "is-plain-object/**/*",
        "isobject/**/*",
        "jsonfile/**/*",
        "kind-of/**/*",
        "lazy-cache/**/*",
        "lilconfig/**/*",
        "merge-deep/**/*",
        "minimatch/**/*",
        "mitt/**/*",
        "mixin-object/**/*",
        "modern-tar/**/*",
        "ms/**/*",
        "once/**/*",
        "path-is-absolute/**/*",
        "pend/**/*",
        "playwright-core/**/*",
        "playwright-extra/**/*",
        "proxy-agent/**/*",
        "puppeteer/**/*",
        "puppeteer-core/**/*",
        "puppeteer-extra/**/*",
        "puppeteer-extra-plugin/**/*",
        "puppeteer-extra-plugin-stealth/**/*",
        "puppeteer-extra-plugin-user-data-dir/**/*",
        "puppeteer-extra-plugin-user-preferences/**/*",
        "rimraf/**/*",
        "shallow-clone/**/*",
        "string-width/**/*",
        "strip-ansi/**/*",
        "typed-query-selector/**/*",
        "universalify/**/*",
        "utf-8-validate/**/*",
        "webdriver-bidi-protocol/**/*",
        "wrap-ansi/**/*",
        "wrappy/**/*",
        "ws/**/*",
        "y18n/**/*",
        "yargs/**/*",
        "yargs-parser/**/*",
        "yauzl/**/*",
        "zod/**/*"
      ]
    }
  ]
}
